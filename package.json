{
  "name": "md-to-anything",
  "version": "0.1.0",
  "description": "Convert Markdown to PDF, DOCX, or HTML using templates",
  "type": "module",
  "bin": {
    "md-to": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "markdown",
    "pdf",
    "docx",
    "html",
    "cli",
    "converter"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.3",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.1",
    "nunjucks": "^3.2.4",
    "picocolors": "^1.1.1",
    "puppeteer": "^25.0.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.1",
    "@types/nunjucks": "^3.2.6",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
