{
  "name": "md-to-anything",
  "version": "0.1.0",
  "description": "Convert Markdown to PDF, DOCX, or HTML using clean templates",
  "type": "module",
  "bin": {
    "md-to": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup src/cli.ts --format esm --out-dir dist --clean",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "markdown",
    "pdf",
    "docx",
    "html",
    "converter",
    "cli",
    "templates",
    "pandoc",
    "puppeteer"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "commander": "^14.0.3",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.1",
    "nunjucks": "^3.2.4",
    "p-limit": "^7.3.0",
    "picocolors": "^1.1.1",
    "puppeteer": "^25.0.4",
    "shiki": "^4.1.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.1",
    "@types/nunjucks": "^3.2.6",
    "@types/ws": "^8.18.1",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
